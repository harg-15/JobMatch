DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobmatch

# LLM used for re-ranking. Any OpenAI-compatible API works.
# Leave LLM_API_KEY empty to run without re-ranking (plain vector search).

# Gemini (has a free tier) - key from aistudio.google.com
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Groq (also free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# OpenAI
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
